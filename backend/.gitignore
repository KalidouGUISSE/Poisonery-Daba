# ============================================
# Backend PoissyShop - GitIgnore
# ============================================
# Stack: Node.js + Express + Prisma + PostgreSQL

# ============================================
# DEPENDANCES ET PACKAGES
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ============================================
# BUILD ET COMPILATION
# ============================================
dist/
build/
*.tsbuildinfo

# ============================================
# PRISMA
# ============================================
# Généré automatiquement (à garder dans le repo)
/src/generated/prisma

# Migrations (optionnel - peut être commité pour le versioning)
/prisma/migrations/*/migration.sql

# ============================================
# ENVIRONNEMENT ET CONFIGURATION
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Configuration locale
config/local.json
config/local.js
config/local.ts

# ============================================
# BASES DE DONNEES
# ============================================
# PostgreSQL
*.log
*.pid

# SQLite (si utilisé pour les tests)
*.sqlite
*.sqlite3
*.db

# ============================================
# LOGS ET DEBUGGING
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs d'application
app.log
error.log
combined.log
access.log

# ============================================
# CACHE ET TEMPORAIRE
# ============================================
.cache/
.tmp/
temp/
*.tmp
*.temp

# ============================================
# TESTS
# ============================================
coverage/
.nyc_output/
*.lcov
test-results/
junit.xml

# ============================================
# IDE ET EDITEURS
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# DEPLOIEMENT
# ============================================
# Docker (si utilisé)
docker-compose.override.yml

# PM2
ecosystem.config.js
processes.json

# ============================================
# SSL ET CERTIFICATS
# ============================================
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# ============================================
# FICHIERS SENSIBLES
# ============================================
secrets.json
secrets.yml
keys.json
keys.yml

# Tokens et clés API
*.key
*.pem

# ============================================
# BACKUPS
# ============================================
*.bak
*.backup
*.old
*.orig

# ============================================
# OS SPECIFIQUES
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

