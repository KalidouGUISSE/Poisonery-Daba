NODE_ENV=development
PORT=4000
API_PREFIX=/api

MONGODB_URI=mongodb://127.0.0.1:27017/poissyshop

JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Keep false while the current frontend does not send Authorization headers.
# Set true when the frontend is updated to use JWT.
AUTH_REQUIRED=false

# Keep false while the current frontend updates stock after creating a sale.
# Set true after removing the frontend-side updateStock call from SaleForm.
SALE_DECREMENTS_STOCK=false

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_SELLER_USERNAME=vendeur1
DEFAULT_SELLER_PASSWORD=vendeur123
